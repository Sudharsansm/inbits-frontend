# Base URL of the InBits backend (inbits-backend). No trailing slash.
# The WebSocket URL is derived automatically (http->ws, https->wss).
#
# Leave this UNSET for the docker-compose deployment (nginx handles
# routing /api and /ws to the backend under the same public domain, so
# the browser just uses its own origin — see src/lib/api.ts). Only set
# this if the frontend and backend are NOT served from the same domain.
#
# NOTE: this is baked into the client bundle at BUILD time (Vite
# convention) — changing it requires a rebuild, it can't be swapped at
# container-start time like a normal backend env var.
VITE_API_BASE_URL=http://localhost:8000

# Server-side (SSR) only, read at container start — NOT baked into the
# client bundle. Used only when VITE_API_BASE_URL above is left unset:
# tells the server-rendered first page which backend to call internally.
# In docker-compose this is the backend service's internal hostname.
INTERNAL_API_BASE_URL=http://backend:8000
